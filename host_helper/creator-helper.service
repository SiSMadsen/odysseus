# Creator host helper (docs/creator-plan.md, Phase 6a: hello only).
# Install: see host_helper/README.md. Kill switch: `sudo systemctl stop creator-helper`.
[Unit]
Description=Odysseus Creator host helper (hello only)
After=local-fs.target

[Service]
Type=simple
User=creator
Group=creator
ExecStart=/usr/bin/python3 /opt/creator-helper/creator_helper.py --allow-uid 1000 --socket /srv/creator-helper/helper.sock --audit-log /var/log/creator-helper/audit.jsonl
# /var/log/creator-helper, owned by `creator`, mode 0700. Read it with sudo.
LogsDirectory=creator-helper
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5

# Hardening. 6a only answers hello, so it can be locked down hard. 6b (running
# commands as `creator`) will need some of this loosened, deliberately.
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/srv/creator-helper
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
