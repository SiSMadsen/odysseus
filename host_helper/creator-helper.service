# Creator host helper (docs/creator-plan.md, Phase 6).
# Install: see host_helper/README.md. Kill switch: `sudo systemctl stop creator-helper`
# (stops the helper and every command it started: they're in its cgroup).
[Unit]
Description=Odysseus Creator host helper
After=local-fs.target

[Service]
Type=simple
User=creator
Group=creator
ExecStart=/usr/bin/python3 /opt/creator-helper/creator_helper.py --allow-uid 1000 --socket /srv/creator-helper/helper.sock --audit-log /var/log/creator-helper/audit.jsonl
# /var/log/creator-helper, owned by `creator`, mode 0700. Read it with sudo.
LogsDirectory=creator-helper
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5

# Hardening. These apply to every command the helper runs, too.
# - No sudo, no setuid: NoNewPrivileges, no capabilities, RestrictSUIDSGID.
#   Restarting Apache goes through polkit instead (50-creator-apache.rules).
# - Writable: only the helper's own folder and the web root. The rest of the
#   system is read-only to it; /home (yours, with Odysseus's data/ and its
#   keys) is invisible.
# - Network: allowed for commands (decision 1, 2026-10-02), so it can check
#   a page with curl. The helper itself listens only on its Unix socket.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/srv/creator-helper /var/www/html
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Not MemoryDenyWriteExecute: commands inherit it, and it breaks anything
# with a JIT (node, java, some PHP setups).
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
