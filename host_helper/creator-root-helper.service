# Creator root helper (docs/creator-plan.md, Phases 5b, 5c and 5d).
# Install: see host_helper/README.md ("The root helper"). Kill switch:
# `sudo systemctl stop creator-root-helper` (root is off at once, and a root
# command still running is stopped with it; a restart also starts with root
# off).
[Unit]
Description=Odysseus Creator root helper (the root switch)
After=local-fs.target

[Service]
Type=simple
# Root, on purpose: the switch has to be out of reach of everything it guards.
User=root
# --odysseus-dir: the Odysseus folder on this host. The watchdog refuses root
# commands that name it. Change it if yours is elsewhere.
ExecStart=/usr/bin/python3 /opt/creator-root/root_helper.py serve --allow-uid 1000 --odysseus-dir /home/madsen/odysseus
# /var/lib/creator-root (the last code used, the watchdog's settings),
# /var/log/creator-root (audit log), /run/creator-root (the control socket):
# root only.
StateDirectory=creator-root
StateDirectoryMode=0700
LogsDirectory=creator-root
LogsDirectoryMode=0700
RuntimeDirectory=creator-root
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5

# Hardening. The helper itself only switches, judges and asks systemd (as
# root, over systemd's own socket) to start each root command in its own
# short-lived unit (systemd-run), with that unit's own walls (5d). The
# commands are not its children, so none of this has to be loosened for them.
# - No capabilities at all: as the owner of its own files it needs none.
# - No network: it listens only on its two Unix sockets.
# - Writable: only its socket folder and the directories above. /etc (the
#   TOTP key) is read-only to it; /home is invisible.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=/srv/creator-root
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
